# Configuração ÚNICA do projeto: os agentes do Prisma (projeto_agentes), o agente-sql e o servidor
# do assistente do PrismaAPP leem este mesmo arquivo. Copie para .env e preencha.
# O .env não vai para o Git. Nunca cole o conteúdo dele em chats ou issues.

# ---------------- Pluggy (Open Finance): fonte de todos os dados (./prisma.sh pluggy)
# Credenciais do painel da Pluggy e o itemId de cada banco conectado (separados por vírgula).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=

# ---------------- Gemini (Especialista, Consultas, agente-sql e assistente do app)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_S=40

# ---------------- Especialista
# Embeddings da base de conhecimento: local (modelo na máquina, sem chave), gemini ou lexico (por palavras, sem modelo)
PRISMA_EMBEDDINGS=local

# ---------------- Assistente do PrismaAPP (servidor do app, porta 8010)
# Token que o app envia. Se ficar vazio, ./prisma.sh app gera um.
APP_TOKENS=
LIMITE_POR_MINUTO=20
LIMITE_PERGUNTAS_POR_DIA=100

# ---------------- Opcionais
# PRISMA_APP_DB=~/.prisma/app/prisma.db   # banco da Pluggy
# PRISMA_NOTA_MINIMA=0.5               # ajuste com ./prisma.sh especialista avaliar (cada modo tem sua escala)
# PRISMA_LOG_PROMPTS=0                    # desliga o registro dos prompts em ~/.prisma/logs/prompts.jsonl

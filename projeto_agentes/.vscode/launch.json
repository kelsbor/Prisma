{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "pergunta",
      "type": "promptString",
      "description": "Pergunta para o especialista",
      "default": "O que acontece se eu pagar só o mínimo da fatura?"
    }
  ],
  "configurations": [
    {
      "name": "Especialista: indexar base",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "module": "especialista",
      "args": [
        "indexar"
      ]
    },
    {
      "name": "Especialista: status da base",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "module": "especialista",
      "args": [
        "status"
      ]
    },
    {
      "name": "Especialista: buscar na base",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "module": "especialista",
      "args": [
        "buscar",
        "${input:pergunta}"
      ]
    },
    {
      "name": "Especialista: perguntar com os meus dados",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "module": "especialista",
      "args": [
        "perguntar",
        "${input:pergunta}",
        "--com-dados"
      ]
    },
    {
      "name": "Especialista: resumo do mês (Pluggy)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "module": "especialista",
      "args": [
        "resumo"
      ]
    },
    {
      "name": "Indicadores: juros do crédito",
      "type": "debugpy",
      "request": "launch",
      "module": "indicadores",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "juros"
      ]
    },
    {
      "name": "Indicadores: simular R$ 1.000 no rotativo",
      "type": "debugpy",
      "request": "launch",
      "module": "indicadores",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "simular",
        "--valor",
        "1000",
        "--modalidade",
        "rotativo",
        "--meses",
        "3"
      ]
    },
    {
      "name": "Consultas: perguntar",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "module": "consultas",
      "args": [
        "perguntar",
        "${input:pergunta}"
      ]
    },
    {
      "name": "Testes",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
# Copie para .env (na raiz do projeto) e preencha. O .env não vai para o Git.
GOOGLE_API_KEY=

# Embeddings da base de conhecimento:
#   gemini (padrão, usa a chave acima) ou local (roda na máquina, sem chave; baixa ~220 MB na 1ª vez)
# PRISMA_EMBEDDINGS=local

# Opcionais
# PRISMA_MODELO_LLM=gemini-3.5-flash-lite
# PRISMA_MODELO_EMBEDDING=models/gemini-embedding-001
# PRISMA_NOTA_MINIMA=0.5

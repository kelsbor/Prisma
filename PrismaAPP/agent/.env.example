# Copie para .env e preencha. O .env NUNCA deve ser versionado ou compartilhado.

# Chave da API do Gemini (Google AI Studio)
GOOGLE_API_KEY=

# Modelo do Gemini (no plano gratuito cada modelo tem sua própria cota diária)
GEMINI_MODEL=gemini-3.5-flash-lite

# Token(s) que o app envia no cabeçalho Authorization (separe vários por vírgula).
# Gere um valor aleatório longo, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKENS=

# Limites por token
LIMITE_POR_MINUTO=20
LIMITE_PERGUNTAS_POR_DIA=100

# Tempo máximo de cada chamada ao Gemini (segundos)
LLM_TIMEOUT_S=40
